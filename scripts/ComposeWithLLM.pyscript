"""
ComposeWithLLM - FL Studio Piano Roll Script for MCP Integration

This script enables AI assistants to control FL Studio's piano roll by:
1. Reading note requests from mcp_request.json
2. Adding, deleting or clearing notes, with expression
3. Exporting the current state to piano_roll_state.json
4. Reporting the outcome to mcp_response.json

Trigger: Cmd+Opt+Y (macOS) or Ctrl+Alt+Y (Windows)

This runs in FL Studio's piano roll sandbox, whose only FL module is flpianoroll.
It cannot see channels, mixer or transport, and it cannot import the server
package, so the settings path resolution is duplicated from
fl_studio_mcp.utils.paths on purpose.

Every trigger writes a response, even when there was nothing to do. The server
waits for one, and a missing reply is indistinguishable from FL Studio not
running.

Based on work from https://github.com/calvinw/fl-studio-mcp
"""

import flpianoroll as flp
import json
import math
import os


def _script_dir():
    """Get the piano roll scripts directory.

    FL_STUDIO_MCP_SETTINGS_DIR overrides it, the same way the controller script
    honours it, so the test harness can keep every file inside a temp directory.
    """
    override = os.environ.get("FL_STUDIO_MCP_SETTINGS_DIR")
    if override:
        return os.path.join(os.path.expanduser(override), "Piano roll scripts")
    return os.path.expanduser(
        "~/Documents/Image-Line/FL Studio/Settings/Piano roll scripts"
    )


SCRIPT_DIR = _script_dir()
REQUEST_FILE = os.path.join(SCRIPT_DIR, "mcp_request.json")
RESPONSE_FILE = os.path.join(SCRIPT_DIR, "mcp_response.json")
STATE_FILE = os.path.join(SCRIPT_DIR, "piano_roll_state.json")

# Every flpianoroll.Note property a request may set, with the type to coerce to.
# The types are read from flpianoroll/__note.py rather than assumed: pitchofs,
# group and repeats are ints, velocity, pan, fcut, fres and release are floats,
# and slide, porta, muted and selected are the only four flags.
#
# This was wrong before. release was in the flag list, so a release of 0.75 became
# True, which is silent because it is still a valid value. One table with the type
# per property is what stops that class of mistake: there is no second list to
# disagree with.
NOTE_PROPERTIES = (
    ("velocity", float),
    ("pan", float),
    ("fcut", float),
    ("fres", float),
    ("release", float),
    ("color", int),
    ("group", int),
    ("pitchofs", int),
    ("repeats", int),
    ("slide", bool),
    ("porta", bool),
    ("muted", bool),
    ("selected", bool),
)

# The ranges the stubs document. FL clamps or truncates rather than complaining, so
# a value outside these would land as something the caller did not ask for and never
# hear about. Only the two integer properties have documented ranges; the floats are
# normalised by FL itself.
NOTE_RANGES = {
    # "This is represented in units of 10 cents, so setting note.pitchofs = 42 will
    # set the pitch offset to +420 cents." Range is -120 to 120.
    "pitchofs": (-120, 120),
    # 0 to 14, each value naming a repeat rate.
    "repeats": (0, 14),
}

# The score members a marker read needs, probed before use. The stubs define all
# three (flpianoroll/__score.py and __marker.py), which is what makes the read worth
# attempting; the probe is what makes its absence a reported fact rather than a lost
# report. See _has_marker_accessors.
MARKER_ACCESSORS = ("markerCount", "getMarker")


def _write_json(path, data):
    """Write JSON to the target file directly, ending with a newline.

    Not atomically, and not through a temporary file: os.replace is blocked in
    this sandbox exactly as it is in the controller sandbox. Measured on FL
    Studio 2026, build 5406, from a piano roll script:

        os.replace(temporary, path)
        SystemError: error return without exception set

    The trailing newline is what lets the server tell a finished file from one it
    caught mid write, since the write cannot be made atomic. The builtin open()
    works here, unlike in the controller sandbox.
    """
    with open(path, "w") as handle:
        json.dump(data, handle, indent=2)
        handle.write("\n")


def _read_requests():
    """Read and empty the request queue.

    The queue is emptied before any request runs, so a request that has already
    been handled cannot replay on the next trigger and duplicate its notes. That
    was a real bug: failures stayed queued and re-ran on the next success.
    """
    if not os.path.exists(REQUEST_FILE):
        return []

    with open(REQUEST_FILE) as handle:
        content = json.load(handle)

    _write_json(REQUEST_FILE, [])

    if isinstance(content, list):
        return content
    if isinstance(content, dict) and content.get("action"):
        return [content]
    return []


def _beat_to_ticks(beats):
    return int(flp.score.PPQ * beats)


def _note_from(data):
    """Build an flpianoroll.Note from a request entry.

    Only the properties the caller named are written. Assigning every property
    would overwrite the Note's own defaults with zeros and flatten expression the
    caller never mentioned, which on a 303 line is the difference between a slide
    and a dead note.
    """
    note = flp.Note()
    note.number = int(data["midi"])
    note.time = _beat_to_ticks(data.get("time", data.get("offset", 0)))
    note.length = _beat_to_ticks(data["duration"])
    for key, coerce in NOTE_PROPERTIES:
        if key not in data:
            continue
        value = coerce(data[key])
        if key in NOTE_RANGES:
            low, high = NOTE_RANGES[key]
            if not low <= value <= high:
                raise ValueError(
                    "note.%s is %s, outside the range %s to %s the API documents"
                    % (key, value, low, high)
                )
        setattr(note, key, value)
    return note


def _assign_group(request):
    """The group index this request should stamp on its notes, or None.

    flp.score.getNextFreeGroupIndex() lives in this sandbox and nowhere else, so the
    script assigns it rather than the server. Note that it is a method on the score
    object, not a module function: the stubs define it on Score, and calling it on
    the module is an AttributeError that only appears at run time inside FL. Its
    docstring says to add one group's notes before calling it again, so this resolves
    once per request rather than per note.

    An explicit number on a note wins over this, because a caller that named a group
    for one note meant it.
    """
    if not request.get("group"):
        return None
    return flp.score.getNextFreeGroupIndex()


def _handle_add_notes(request):
    group = _assign_group(request)
    added = 0
    for data in request.get("notes", []):
        note = _note_from(data)
        if group is not None and "group" not in data:
            note.group = group
        flp.score.addNote(note)
        added += 1
    return {"notes_added": added, "notes_deleted": 0, "group": group}


def _handle_add_chord(request):
    group = _assign_group(request)
    base_time = _beat_to_ticks(request.get("time", 0))
    default_duration = request.get("duration", 1.0)
    added = 0
    for data in request.get("notes", []):
        data = dict(data)
        data.setdefault("duration", default_duration)
        note = _note_from(data)
        if group is not None and "group" not in data:
            note.group = group
        note.time = base_time + _beat_to_ticks(data.get("offset", 0))
        flp.score.addNote(note)
        added += 1
    return {"notes_added": added, "notes_deleted": 0, "group": group}


def _handle_clear(request):
    count = flp.score.noteCount
    for index in range(count - 1, -1, -1):
        flp.score.deleteNote(index)
    return {"notes_added": 0, "notes_deleted": count}


def _handle_delete_notes(request):
    criteria = [
        (int(entry["midi"]), _beat_to_ticks(entry["time"]))
        for entry in request.get("notes", [])
    ]
    deleted = 0
    for index in range(flp.score.noteCount - 1, -1, -1):
        note = flp.score.getNote(index)
        for number, time in criteria:
            if note.number == number and note.time == time:
                flp.score.deleteNote(index)
                deleted += 1
                break
    return {"notes_added": 0, "notes_deleted": deleted}


def _handle_get_context(request):
    """Report the project's key and meter, which only this sandbox can see.

    flpianoroll.score exposes snap_root_note, snap_scale_helper, tsnum and tsden,
    and nothing in the controller sandbox can reach them. snap_scale_helper is a
    string of 0 and 1 separated by commas, always aligned to C, where 0 means in the
    scale. It is not an index, and reading it as one is a silent way to get a wrong
    key.
    """
    return {
        "notes_added": 0,
        "notes_deleted": 0,
        "root_note": flp.score.snap_root_note,
        "scale_helper": flp.score.snap_scale_helper,
        "tsnum": flp.score.tsnum,
        "tsden": flp.score.tsden,
        "ppq": flp.score.PPQ,
    }


def _read_property(owner, name):
    """One property of an FL object, as (value, error text).

    Every guarded read here goes through this, so a property that raises costs its
    own field and nothing else. The controller's arrangement reader guards each
    marker name the same way, for the same reason: one unreadable marker must not
    lose the rest of the arrangement.
    """
    try:
        return getattr(owner, name), None
    except Exception as error:
        return None, "%s: %s" % (type(error).__name__, error)


def _ticks(value):
    """A marker time as a whole number of ticks.

    bool is an int in Python, and a marker whose time read back as True would
    otherwise be reported as tick 1, which is a position no producer placed.
    """
    if value is None or isinstance(value, bool):
        raise TypeError("time is %r, which is not a tick position" % (value,))
    return int(value)


def _marker_entry(marker, index):
    """One marker as a reply entry, reading each property on its own.

    A marker whose name or time cannot be read keeps its index, reports None for
    that field, and carries the reason beside it, so one broken marker does not
    lose the markers after it.
    """
    entry = {"index": index, "name": None, "time": None}

    name, name_error = _read_property(marker, "name")
    if name_error:
        entry["name_error"] = name_error
    else:
        entry["name"] = name

    time, time_error = _read_property(marker, "time")
    if time_error is None:
        try:
            time = _ticks(time)
        except Exception as error:
            time_error = "%s: %s" % (type(error).__name__, error)
    if time_error:
        entry["time_error"] = time_error
    else:
        entry["time"] = time
    return entry


def _has_marker_accessors(score):
    """Whether the score object carries the marker readers, probed and not assumed.

    The stubs define markerCount, getMarker and Marker.time, so the names are not a
    guess about what the API ought to look like. Whether the sandbox FL is actually
    running has them is a different question: a stub is documentation, not a
    measurement, and this project has twice shipped a fake that agreed with the code
    instead of with FL. getattr is used rather than hasattr because a property that
    raises something other than AttributeError propagates out of hasattr, and a
    sandbox that cannot read a marker count is the case this exists to report.
    """
    for name in MARKER_ACCESSORS:
        try:
            getattr(score, name)
        except Exception:
            return False
    return True


def _handle_get_markers(request):
    """Report the piano roll's markers, and the project's key and meter with them.

    flpianoroll.score is the only place a marker's time can be read. The controller
    sandbox, which owns the arrangement, has no marker time reader at all, so
    arrangement.getMarkers reports a name and a null time for every marker. This
    action is that read, and it is read only: nothing here writes to the score.

    The key and meter travel with the markers because the structure critique needs
    both and one script run answers both. Asking in two requests would spend a second
    keystroke and a second wait on data this run already has.

    What comes back is the marker list as this sandbox sees it, in this sandbox's
    index order, with times in ticks. Whether that list is the arrangement's list is
    not something either sandbox can check, because they cannot see each other, so
    the caller compares the counts and reports a disagreement rather than assuming
    the two views line up.

    This handler does not raise when markers cannot be read. A sandbox without the
    accessors, or a marker whose properties fail, comes back with whatever could be
    read and a sentence naming what could not.
    """
    score = flp.score
    ppq, _ = _read_property(score, "PPQ")
    root_note, _ = _read_property(score, "snap_root_note")
    scale_helper, _ = _read_property(score, "snap_scale_helper")
    tsnum, _ = _read_property(score, "tsnum")
    tsden, _ = _read_property(score, "tsden")

    reply = {
        "notes_added": 0,
        "notes_deleted": 0,
        "markers": None,
        "markers_error": None,
        "root_note": root_note,
        "scale_helper": scale_helper,
        "tsnum": tsnum,
        "tsden": tsden,
        "ppq": ppq,
    }

    if not _has_marker_accessors(score):
        reply["markers_error"] = (
            "This piano roll sandbox does not expose markers: flpianoroll.score has "
            "no readable %s, so a marker's time cannot be read here."
            % " and no readable ".join(MARKER_ACCESSORS)
        )
        return reply

    count, count_error = _read_property(score, "markerCount")
    if count_error:
        reply["markers_error"] = "The piano roll reported no marker count: %s" % count_error
        return reply
    try:
        count = _ticks(count)
    except Exception as error:
        reply["markers_error"] = (
            "The piano roll reported a marker count that is not a number: %s: %s"
            % (type(error).__name__, error)
        )
        return reply

    markers = []
    for index in range(max(0, count)):
        try:
            marker = score.getMarker(index)
        except Exception as error:
            markers.append({
                "index": index,
                "name": None,
                "time": None,
                "error": "%s: %s" % (type(error).__name__, error),
            })
            continue
        markers.append(_marker_entry(marker, index))

    reply["markers"] = markers
    return reply


def _handle_get_state(request):
    """Export the state and change nothing.

    The server's fl_get_piano_roll_state triggers the script to refresh the
    exported state. Without this action the trigger still exports, but the reply
    carries an "Unknown action" error, which is a lie: the request succeeded.
    """
    return {"notes_added": 0, "notes_deleted": 0}


HANDLERS = {
    "add_notes": _handle_add_notes,
    "add_chord": _handle_add_chord,
    "clear": _handle_clear,
    "delete_notes": _handle_delete_notes,
    "get_state": _handle_get_state,
    "get_context": _handle_get_context,
    "get_markers": _handle_get_markers,
}


def _handle(request):
    """Run one request and return its response body, never raising."""
    action = request.get("action")
    response = {
        "action": action,
        "id": request.get("id"),
        "notes_added": 0,
        "notes_deleted": 0,
        "group": None,
        "group_name": request.get("group_name"),
        "error": None,
    }

    handler = HANDLERS.get(action)
    if handler is None:
        response["error"] = "Unknown action: %s" % action
        return response

    try:
        response.update(handler(request))
    except Exception as error:
        response["error"] = "%s: %s" % (type(error).__name__, error)
    return response


def _export_state():
    """Export the whole piano roll, including the properties nothing writes yet."""
    notes = []
    ppq = flp.score.PPQ

    for index in range(flp.score.noteCount):
        note = flp.score.getNote(index)
        notes.append({
            "number": note.number,
            "midi": note.number,  # alias, for callers that think in MIDI numbers
            "time": note.time / ppq if ppq > 0 else 0,
            "time_ticks": note.time,
            "duration": note.length / ppq if ppq > 0 else 0,
            "length_ticks": note.length,
            "velocity": note.velocity,
            "pan": note.pan,
            "color": note.color,
            "fcut": note.fcut,
            "fres": note.fres,
            "slide": note.slide,
            "porta": note.porta,
            "pitchofs": note.pitchofs,
            "release": note.release,
            "repeats": note.repeats,
            "group": note.group,
            "selected": note.selected,
            "muted": note.muted,
        })

    return {
        "ppq": ppq,
        "noteCount": flp.score.noteCount,
        "notes": notes,
    }


def export_piano_roll_state():
    """Write the current piano roll state to STATE_FILE."""
    _write_json(STATE_FILE, _export_state())
    return STATE_FILE


def apply(form=None):
    """Process pending requests, export state, and report the outcome.

    AUTO MODE. Triggered by the MCP server's keystroke, so it shows no UI.
    """
    responses = []
    try:
        requests = _read_requests()
    except Exception as error:
        requests = []
        responses.append({
            "action": None,
            "id": None,
            "notes_added": 0,
            "notes_deleted": 0,
            "error": "Could not read the request file: %s" % error,
        })

    for request in requests:
        responses.append(_handle(request))

    state_error = None
    try:
        _write_json(STATE_FILE, _export_state())
    except Exception as error:
        state_error = "Could not export the piano roll state: %s" % error

    errors = [response["error"] for response in responses if response["error"]]
    if state_error:
        errors.append(state_error)

    # Per-request fields are echoed from the response that matches the id the
    # caller asked about, which is the first response when a single request was
    # queued. Deriving this from the count of responses was wrong: two queued
    # requests, a context read followed by a write, made every one of these null,
    # so the caller was told the key and meter were unknown when the script had
    # answered them. Matching on the id is what the transport already does, and it
    # works for one request and for several.
    lead = responses[0] if responses else {}

    _write_json(RESPONSE_FILE, {
        "success": not errors,
        "id": lead.get("id"),
        "group": lead.get("group"),
        "group_name": lead.get("group_name"),
        "requests_processed": len(responses),
        "notes_added": sum(response["notes_added"] for response in responses),
        "root_note": lead.get("root_note"),
        "scale_helper": lead.get("scale_helper"),
        "tsnum": lead.get("tsnum"),
        "tsden": lead.get("tsden"),
        "context_ppq": lead.get("ppq"),
        # The marker list the get_markers handler read, and its sentence when the
        # sandbox could not read one. Both are echoed per response as well, so a
        # caller that queued more than one request can match the answer it wants.
        "markers": lead.get("markers"),
        "markers_error": lead.get("markers_error"),
        "notes_deleted": sum(response["notes_deleted"] for response in responses),
        # Every response, each with its own id, so a caller that queued more than
        # one request can match the answer it wants instead of reading whichever
        # happened to be first. The scalars above are the lead response, which is
        # the whole answer for the usual single-request case.
        "responses": [
            {
                "id": response.get("id"),
                "action": response.get("action"),
                "notes_added": response.get("notes_added"),
                "notes_deleted": response.get("notes_deleted"),
                "group": response.get("group"),
                "group_name": response.get("group_name"),
                "root_note": response.get("root_note"),
                "scale_helper": response.get("scale_helper"),
                "tsnum": response.get("tsnum"),
                "tsden": response.get("tsden"),
                "ppq": response.get("ppq"),
                "markers": response.get("markers"),
                "markers_error": response.get("markers_error"),
                "error": response.get("error"),
            }
            for response in responses
        ],
        "error": "; ".join(errors) if errors else None,
    })
